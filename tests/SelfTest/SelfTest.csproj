<Project Sdk="Microsoft.NET.Sdk">

  <!-- dev-only: runs the WPF-free core selftest on mac/linux against system ffmpeg + libmpv.
       the real gate is cut.exe with the selftest flag on windows in CI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Cut.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../src/Core/*.cs" />
  </ItemGroup>

</Project>
