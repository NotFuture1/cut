<Window x:Class="Cut.UI.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="export"
        Background="{StaticResource WindowBgBrush}"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="18,16">

        <StackPanel x:Name="SetupPanel">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="mode"
                           Foreground="{StaticResource TextDimBrush}" FontSize="12" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="ModeBox" Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                          SelectionChanged="OnModeChanged" Margin="0,0,0,8">
                    <ComboBoxItem Content="lossless" IsSelected="True"/>
                    <ComboBoxItem Content="precise (re-encode)"/>
                </ComboBox>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="format"
                           Foreground="{StaticResource TextDimBrush}" FontSize="12" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="FormatBox" Grid.Row="1" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                          SelectionChanged="OnFormatChanged" Margin="0,0,0,8">
                    <ComboBoxItem Content="same as input" IsSelected="True"/>
                    <ComboBoxItem Content="mp4"/>
                    <ComboBoxItem Content="mkv"/>
                </ComboBox>

                <TextBlock x:Name="CrfLabel" Grid.Row="2" Grid.Column="0" Text="quality"
                           Foreground="{StaticResource TextDimBrush}" FontSize="12" FontFamily="Segoe UI"
                           VerticalAlignment="Center" Visibility="Collapsed"/>
                <DockPanel x:Name="CrfRow" Grid.Row="2" Grid.Column="1" Margin="0,0,0,8"
                           Visibility="Collapsed">
                    <TextBlock x:Name="CrfValue" DockPanel.Dock="Right" Text="crf 18"
                               Foreground="{StaticResource TextDimBrush}" FontSize="11.5" FontFamily="Consolas"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <Slider x:Name="CrfSlider" Style="{StaticResource DarkSlider}"
                            Minimum="16" Maximum="28" Value="18"
                            IsSnapToTickEnabled="True" TickFrequency="1"
                            ValueChanged="OnCrfChanged" VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="save to"
                           Foreground="{StaticResource TextDimBrush}" FontSize="12" FontFamily="Segoe UI"
                           VerticalAlignment="Center"/>
                <DockPanel Grid.Row="3" Grid.Column="1">
                    <Button DockPanel.Dock="Right" Style="{StaticResource DarkButton}" Content="browse"
                            Click="OnBrowseClick" Margin="8,0,0,0"/>
                    <TextBox x:Name="OutBox" Style="{StaticResource DarkTextBox}"
                             TextChanged="OnOutEdited"/>
                </DockPanel>
            </Grid>

            <TextBlock x:Name="NoteText" Margin="0,12,0,0"
                       Foreground="{StaticResource TextDimBrush}" FontSize="11.5" FontFamily="Segoe UI"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="WarnText" Margin="0,4,0,0"
                       Foreground="#D0A868" FontSize="11.5" FontFamily="Segoe UI"
                       TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="SummaryText" Margin="0,10,0,0"
                       Foreground="{StaticResource TextBrush}" FontSize="12" FontFamily="Segoe UI"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource DarkButton}" Content="cancel" Click="OnCancelClick"
                        Margin="0,0,8,0" MinWidth="80"/>
                <Button x:Name="ExportBtn" Style="{StaticResource AccentButton}" Content="export"
                        Click="OnExportClick" MinWidth="100"/>
            </StackPanel>
        </StackPanel>

        <StackPanel x:Name="RunPanel" Visibility="Collapsed">
            <TextBlock x:Name="RunStatus" Text="exporting"
                       Foreground="{StaticResource TextBrush}" FontSize="12.5" FontFamily="Segoe UI"/>
            <ProgressBar x:Name="RunProgress" Style="{StaticResource DarkProgressBar}"
                         Minimum="0" Maximum="100" Margin="0,10,0,0"/>
            <TextBlock x:Name="RunPercent" Text="0%"
                       Foreground="{StaticResource TextDimBrush}" FontSize="11.5" FontFamily="Consolas"
                       Margin="0,6,0,0"/>
            <TextBox x:Name="ErrorBox" Style="{StaticResource DarkTextBox}" Visibility="Collapsed"
                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                     Height="110" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button x:Name="ShowBtn" Style="{StaticResource DarkButton}" Content="show in folder"
                        Click="OnShowClick" Margin="0,0,8,0" Visibility="Collapsed"/>
                <Button x:Name="AbortBtn" Style="{StaticResource DarkButton}" Content="cancel"
                        Click="OnAbortClick" MinWidth="80"/>
            </StackPanel>
        </StackPanel>

    </StackPanel>
</Window>
