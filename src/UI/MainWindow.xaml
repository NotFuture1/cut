<Window x:Class="Cut.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Cut.UI"
        Title="cut"
        Background="{StaticResource WindowBgBrush}"
        FontFamily="{StaticResource UiFont}"
        MinWidth="900" MinHeight="600"
        AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver"
        PreviewKeyDown="OnKeyDown"
        Closing="OnClosing">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="ToolbarRow" Height="46"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition x:Name="SplitRow" Height="6"/>
            <RowDefinition x:Name="BottomRow" Height="300" MinHeight="170"/>
        </Grid.RowDefinitions>

        <!-- toolbar -->
        <Border x:Name="Toolbar" Grid.Row="0" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel Margin="10,0">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Button x:Name="OpenBtn" Style="{StaticResource DarkButton}" Click="OnOpenClick" ToolTip="ctrl+o">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="open" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddBtn" Style="{StaticResource DarkButton}" Click="OnAddClick" Margin="8,0,0,0"
                            ToolTip="put an image, video or audio file over the video (ctrl+i)" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="add media" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="UpdateBtn" Style="{StaticResource PillButton}" Visibility="Collapsed"
                            Click="OnUpdateClick" Margin="0,0,12,0"/>
                    <Border Style="{StaticResource SegmentBox}" Margin="0,0,10,0"
                            ToolTip="exact re-encodes: frame-accurate cuts, layers, size control. fast copies the original: instant, but each cut starts on a keyframe.">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ExactMode" Style="{StaticResource Segment}" GroupName="mode" Content="exact"
                                         Checked="OnModeChanged" IsChecked="True"/>
                            <RadioButton x:Name="FastModeRadio" Style="{StaticResource Segment}" GroupName="mode" Content="fast"
                                         Checked="OnModeChanged"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="ExportBtn" Style="{StaticResource AccentButton}" Click="OnExportClick" ToolTip="ctrl+e"
                            Padding="16,5" IsEnabled="False">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="export" VerticalAlignment="Center"/>
                            <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="11" VerticalAlignment="Center" Margin="8,1,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="FileText" Style="{StaticResource BaseText}" FontSize="12.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                    <TextBlock x:Name="InfoText" Style="{StaticResource DimText}" FontSize="11.5" Margin="10,1,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- preview + inspector -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="InspectorCol" Width="304"/>
            </Grid.ColumnDefinitions>

            <Grid x:Name="VideoArea" Grid.Column="0" Background="#FF0A0A0B"
                  MouseLeftButtonDown="OnVideoMouseDown" MouseMove="OnVideoMouseMove"
                  MouseLeftButtonUp="OnVideoMouseUp">
                <!-- MpvHost is added here in code at startup -->
                <Border x:Name="EmptyState" Background="#FF0A0A0B">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <Border Width="64" Height="64" CornerRadius="16" Background="{StaticResource RaisedBgBrush}"
                                BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE8B2;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                       Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="drop a video here" Style="{StaticResource BaseText}" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,4"/>
                        <TextBlock Text="or press ctrl+o. mp4, mkv, mov, webm, and the rest." Style="{StaticResource DimText}"
                                   HorizontalAlignment="Center"/>
                        <Button Style="{StaticResource AccentButton}" Content="open a video" Click="OnOpenClick"
                                HorizontalAlignment="Center" Margin="0,16,0,0" Padding="18,6"/>
                        <TextBlock x:Name="RecentLabel" Text="recent" Style="{StaticResource LabelText}" Margin="0,26,0,6"
                                   Visibility="Collapsed"/>
                        <StackPanel x:Name="RecentList"/>
                    </StackPanel>
                </Border>
            </Grid>

            <Border x:Name="InspectorPanel" Grid.Column="1" Background="{StaticResource PanelBgBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="InspectorHost" Margin="18,16,18,18"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" DragCompleted="OnSplitDone"/>

        <!-- transport + tools + timeline -->
        <DockPanel x:Name="Bottom" Grid.Row="3">
            <Grid DockPanel.Dock="Top" Margin="8,0,8,4" Height="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Content="&#xE892;" Click="OnPrevEdit" ToolTip="previous edit (up)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE76B;" Click="OnFrameBackClick" ToolTip="previous frame (left)"/>
                    <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;" Click="OnPlayPauseClick"
                            ToolTip="play / pause (space)" Width="38" FontSize="16"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE76C;" Click="OnFrameForwardClick" ToolTip="next frame (right)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE893;" Click="OnNextEdit" ToolTip="next edit (down)"/>
                    <TextBlock x:Name="TimeText" Text="0:00.00" Style="{StaticResource BaseText}" FontSize="13"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <TextBlock x:Name="DurText" Text=" / 0:00.00" Style="{StaticResource DimText}" FontSize="13"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource DimText}" FontSize="11.5"
                               VerticalAlignment="Center" Margin="16,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button x:Name="SplitTool" Style="{StaticResource ToolButton}" Click="OnSplitClick" ToolTip="split the video at the playhead">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="split" VerticalAlignment="Center"/>
                            <TextBlock Text="s" Foreground="{StaticResource TextFaintBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnMarkIn" ToolTip="mark the start of a part at the playhead">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="in" VerticalAlignment="Center"/>
                            <TextBlock Text="i" Foreground="{StaticResource TextFaintBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnMarkOut" ToolTip="mark the end of a part at the playhead">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="out" VerticalAlignment="Center"/>
                            <TextBlock Text="o" Foreground="{StaticResource TextFaintBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="16" Background="{StaticResource PanelBorderBrush}" Margin="6,0"/>
                    <Button x:Name="CutTool" Style="{StaticResource ToolButton}" Click="OnCutClick" ToolTip="cut the marked part out of everything">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8C6;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="cut" VerticalAlignment="Center"/>
                            <TextBlock Text="x" Foreground="{StaticResource TextFaintBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="MuteTool" Style="{StaticResource ToolButton}" Click="OnMuteClick" ToolTip="mute the marked part (one lane, or all audio)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74F;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="mute" VerticalAlignment="Center"/>
                            <TextBlock Text="m" Foreground="{StaticResource TextFaintBrush}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="SkipCutsToggle" Style="{StaticResource IconToggle}" IsChecked="True"
                                  Checked="OnSkipCutsChanged" Unchecked="OnSkipCutsChanged"
                                  ToolTip="play only what you keep (p)">
                        <TextBlock Text="skip cuts" VerticalAlignment="Center"/>
                    </ToggleButton>
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource IconFont}" FontSize="13"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="12,0,6,0"/>
                    <Slider x:Name="PreviewVolumeSlider" Style="{StaticResource DarkSlider}" Width="84"
                            Minimum="0" Maximum="100" Value="100" ValueChanged="OnPreviewVolumeChanged"
                            VerticalAlignment="Center" ToolTip="preview volume"/>
                    <Border Width="1" Height="16" Background="{StaticResource PanelBorderBrush}" Margin="10,0"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE71F;" Click="OnZoomOut" ToolTip="zoom out (-)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE9A6;" Click="OnZoomFit" ToolTip="fit (\)"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE8A3;" Click="OnZoomIn" ToolTip="zoom in (+)"/>
                    <ToggleButton x:Name="InspectorToggle" Style="{StaticResource IconToggle}" IsChecked="True"
                                  Checked="OnInspectorToggle" Unchecked="OnInspectorToggle" ToolTip="details panel" Margin="6,0,0,0">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="13" VerticalAlignment="Center"/>
                    </ToggleButton>
                </StackPanel>
            </Grid>

            <ui:TimelineView x:Name="Timeline"/>
        </DockPanel>
    </Grid>
</Window>
