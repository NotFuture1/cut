<Window x:Class="Cut.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Cut.UI"
        Title="cut"
        Background="{StaticResource WindowBgBrush}"
        MinWidth="760" MinHeight="500"
        AllowDrop="True"
        Drop="OnDrop" DragOver="OnDragOver"
        PreviewKeyDown="OnKeyDown"
        Closing="OnClosing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- video + tracks sidebar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#FF0A0A0A">
                <Grid x:Name="VideoArea">
                    <TextBlock x:Name="Placeholder"
                               Text="drop a video here or press ctrl+o"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="14" FontFamily="Segoe UI"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- MpvHost is added here in code once the first file opens -->
                </Grid>
            </Border>

            <Border x:Name="TracksPanel" Grid.Column="1" Width="280"
                    Background="{StaticResource PanelBgBrush}"
                    BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0"
                    Visibility="Collapsed">
                <DockPanel Margin="0,8">
                    <TextBlock DockPanel.Dock="Top" Text="audio tracks"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="11" FontFamily="Segoe UI" Margin="14,2,14,8"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="volume and mixing apply to the export"
                               Foreground="{StaticResource TextDimBrush}"
                               FontSize="10.5" FontFamily="Segoe UI" Margin="14,8,14,2"
                               TextWrapping="Wrap"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TracksList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource RowBgBrush}" CornerRadius="8"
                                            Padding="10,8" Margin="8,3">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                                <RadioButton Style="{StaticResource DarkRadio}" GroupName="preview"
                                                             DockPanel.Dock="Left" VerticalAlignment="Center"
                                                             IsChecked="{Binding IsPreview, Mode=TwoWay}"
                                                             Checked="OnPreviewChecked"
                                                             ToolTip="listen to this track"/>
                                                <CheckBox Style="{StaticResource ToggleSwitch}" DockPanel.Dock="Right"
                                                          VerticalAlignment="Center"
                                                          IsChecked="{Binding Include, Mode=TwoWay}"
                                                          ToolTip="include in export"/>
                                                <TextBlock Text="{Binding Label}" Margin="8,0"
                                                           Foreground="{StaticResource TextBrush}"
                                                           FontSize="12" FontFamily="Segoe UI"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                            <DockPanel Grid.Row="1">
                                                <Button Style="{StaticResource IconButton}" DockPanel.Dock="Left"
                                                        Width="26" Height="24" FontSize="13"
                                                        Content="{Binding MuteGlyph}" Click="OnMuteClick"
                                                        ToolTip="mute"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding VolumeText}"
                                                           Foreground="{StaticResource TextDimBrush}"
                                                           FontSize="11" FontFamily="Consolas" Width="38"
                                                           VerticalAlignment="Center" TextAlignment="Right"/>
                                                <Slider Style="{StaticResource DarkSlider}" Margin="6,0"
                                                        Minimum="0" Maximum="200"
                                                        Value="{Binding Volume, Mode=TwoWay}"
                                                        ToolTip="export volume"/>
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- timeline -->
        <ui:TimelineControl x:Name="Timeline" Grid.Row="1" Height="72" Margin="10,8,10,0"/>

        <!-- transport -->
        <DockPanel Grid.Row="2" Margin="10,6,10,8">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="OpenBtn" Style="{StaticResource DarkButton}" Content="open"
                        Click="OnOpenClick" Margin="0,0,8,0" ToolTip="ctrl+o"/>
                <Button x:Name="PlayBtn" Style="{StaticResource IconButton}" Content="&#xE768;"
                        Click="OnPlayPauseClick" ToolTip="space"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE76B;"
                        Click="OnFrameBackClick" ToolTip="previous frame (left)"/>
                <Button Style="{StaticResource IconButton}" Content="&#xE76C;"
                        Click="OnFrameForwardClick" ToolTip="next frame (right)"/>
                <TextBlock x:Name="TimeText" Text="0:00.00 / 0:00.00"
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="12" FontFamily="Consolas"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock x:Name="StatusText" Text=""
                           Foreground="{StaticResource TextDimBrush}"
                           FontSize="11.5" FontFamily="Segoe UI"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                <TextBlock Text="&#xE767;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider x:Name="PreviewVolumeSlider" Style="{StaticResource DarkSlider}" Width="90"
                        Minimum="0" Maximum="100" Value="100"
                        ValueChanged="OnPreviewVolumeChanged"
                        VerticalAlignment="Center" ToolTip="preview volume"/>
                <Button Style="{StaticResource DarkButton}" Content="split"
                        Click="OnSplitClick" Margin="14,0,0,0" ToolTip="split at playhead (s)"/>
                <Button x:Name="TracksBtn" Style="{StaticResource DarkButton}" Content="tracks"
                        Click="OnTracksClick" Margin="8,0,0,0" ToolTip="audio tracks"/>
                <Button Style="{StaticResource AccentButton}" Content="export"
                        Click="OnExportClick" Margin="8,0,0,0" ToolTip="ctrl+e"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
